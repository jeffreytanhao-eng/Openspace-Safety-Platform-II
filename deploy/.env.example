# 复制为 deploy/.env 后按需修改

# 对外端口
WEB_PORT=1233
API_PORT=1234

# 前端部署子路径（默认根路径 /）
VITE_BASE=/

# 静态资源前缀（前端 /cgi/config 返回给页面的 staticBase）
STATIC_BASE=

# MySQL（使用 --profile mysql 启动本地库时生效；也可改为外部库地址）
DB_HOST=mysql
DB_PORT=3306
DB_USER=openspace
DB_PASSWORD=openspace
DB_NAME=openspace
MYSQL_ROOT_PASSWORD=root
