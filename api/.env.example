# 后端环境变量示例（复制为 api/.env）
PORT=1234

# MySQL（可留空/不建库，服务仍能启动，/cgi/health 返回 db:'down'）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=openspace
DB_PASSWORD=
DB_NAME=openspace_safety

# 静态资源前缀（/cgi/config 返回的 staticBase，默认空串）
STATIC_BASE=

# JWT 签名密钥（必填，随机 64 位 hex：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=

# 平台超管 bootstrap（首次启动创建；密码为空则跳过）
PLATFORM_ADMIN_EMAIL=admin@openspace.local
PLATFORM_ADMIN_PASSWORD=

# Space-Track 系统日更（C1）：GP 两行根数 + 公开 CDM；缺失时这两源到点失败并留批次痕迹
SPACETRACK_USER=
SPACETRACK_PASS=
SPACETRACK_BASE_URL=https://www.space-track.org

# AOE（spacemapper）日更（C1）：token 缺失时跳过该源
AOE_TOKEN=
AOE_BASE_URL=https://spacemapper.cn

# 每日日更时刻（UTC，仅支持 'M H * * *' 每日固定时刻），默认每日 06:00
DAILY_FETCH_CRON=0 6 * * *
