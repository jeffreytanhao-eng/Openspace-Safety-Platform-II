# 依赖
node_modules/

# 构建产物
dist/
web/public/cesium/
*.tsbuildinfo

# 环境变量（保留示例文件）
.env
.env.local
.env.*.local
deploy/.env

# 本地测试账号（含明文密码，仅本机使用）
本地测试账号.md

# 日志
*.log
npm-debug.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 参考仓库（仅本地对照，不参与构建）
.reference/

# 本地临时 / 调试产物
Temp/
osp-starlink-src/
api/_probe*.mjs

# 用户文档运行期存储（上传正文按 UUID 落盘，不入库）
data/user-documents/*
!data/user-documents/.gitkeep

# Local public-catalog TSV cache (downloaded by ingest:gcat --download)
data/gcat/*.tsv


# Uploaded catalog / family photos (paths stored in DB)
data/catalog-photos/*
!data/catalog-photos/.gitkeep

